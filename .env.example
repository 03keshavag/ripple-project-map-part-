# Ripple — Map & Discovery environment variables
#
# Controls the data-access layer (src/config.js -> src/api/mapActs.js).
#   true  -> return local mock data (with an artificial delay to show loading states)
#   false -> call the real backend endpoint GET /api/map/acts
# IMPORTANT: copy this file to .env and tweak locally. No secret values live here.
VITE_USE_MOCK_DATA=true

# Backend base URL used when VITE_USE_MOCK_DATA=false.
# Swap this to any deployed backend (e.g. the team demo server) without code
# changes. Defaults to the local backend if unset.
VITE_API_BASE_URL=http://localhost:8000